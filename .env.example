# ===== LOCAL (unlimited by our software) =====
OLLAMA_MODEL=llama3.1
WORKER_CONCURRENCY=2
# whisper.cpp — binary + ggml model path
# WHISPER_CPP_PATH=whisper-cli
# WHISPER_MODEL=/models/whisper/ggml-base.bin
# Piper — binary + voice model
# PIPER_PATH=piper
# PIPER_VOICE=/voices/en_IN-medium.onnx
# FFmpeg + font for text overlays
# FFMPEG_PATH=ffmpeg
# FFMPEG_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
# ComfyUI (optional compose profile: --profile images)
# COMFYUI_URL=http://comfyui:8188
# COMFYUI_CHECKPOINT=sd_xl_base_1.0.safetensors

# ===== EXTERNAL MODELS (100% OPTIONAL — bring your own key) =====
# If a key is set, that connector becomes available; if absent, the router
# skips it and falls back to local. Each provider's OWN limits/fees apply —
# our software never meters anything.
# SEEDANCE_API_KEY=                  (BytePlus ModelArk key)
# SEEDANCE_BASE_URL=https://ark.ap-southeast.bytepluses.com
# SEEDANCE_MODEL=seedance-1-0-lite-8
# LTX_API_KEY=                       (fal.ai key)
# LTX_MODEL=fal-ai/ltx-video
# VEO_API_KEY=                       (Google AI Studio key)
# VEO_MODEL=veo-3.0-generate-001
# AVATAR_API_KEY=

# ===== PUBLISHING (official platform APIs, bring your own tokens) =====
# DASHBOARD_PORT=3000
# MEDIA_DIR=/tmp
# YouTube — direct token, or refresh-token flow
# YOUTUBE_ACCESS_TOKEN=
# YOUTUBE_REFRESH_TOKEN=
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_PRIVACY=public
# YOUTUBE_CATEGORY_ID=22
# Instagram (Reels via Graph API) — IG_VIDEO_BASE_URL must be publicly reachable
# INSTAGRAM_USER_ID=
# INSTAGRAM_ACCESS_TOKEN=
# IG_VIDEO_BASE_URL=https://media.yourdomain.com
# Facebook (Page video)
# FACEBOOK_PAGE_ID=
# FACEBOOK_ACCESS_TOKEN=
